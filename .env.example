APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Explicit Redis caching only; CACHE_STORE remains unchanged.
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache
REDIS_CACHE_PREFIX=fox-hema:${APP_ENV}:cache:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INVOICE_COMPANY_NAME="Fox & Hema"
INVOICE_COMPANY_ADDRESS=
INVOICE_COMPANY_PHONE=
INVOICE_COMPANY_EMAIL=
INVOICE_COMPANY_TAX_NUMBER=
INVOICE_COMPANY_REGISTRATION_NUMBER=

TREASURY_SEED_ACTOR_ID=


ERP_READ_CACHE_ENABLED=true
ERP_READ_CACHE_STORE=redis

# Retail cash UI remains disabled. These gates alone never enable retail checkout.
POS_OFFLINE_RETAIL_PILOT_ENABLED=false
# JSON list of exact branch_id/device_id/cashier_id tuples; no wildcards.
POS_OFFLINE_RETAIL_PILOT_ALLOWLIST=[]
# Required explicit retail values; blank values fail closed. Duration <= 480; identities <= 100.
POS_OFFLINE_AUTHORIZATION_MINUTES=
POS_OFFLINE_CATALOG_SALE_ID_LIMIT=
# Ceilings: EGP 10000 / 100 units per sale; EGP 50000 / 500 units per lease.
POS_OFFLINE_CATALOG_SALE_AMOUNT_LIMIT=
POS_OFFLINE_CATALOG_SALE_QUANTITY_LIMIT=
POS_OFFLINE_CATALOG_EXPOSURE_LIMIT=
POS_OFFLINE_CATALOG_QUANTITY_EXPOSURE_LIMIT=
